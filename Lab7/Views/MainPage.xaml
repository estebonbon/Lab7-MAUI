<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lab7.ViewModels"
             xmlns:mod="clr-namespace:Lab7.Models"
             x:Class="Lab7.Views.MainPage"
             x:DataType="vm:SalesListViewModel"> <!--Specifys the type of object we are binding too, helps at complie time-->

    <ScrollView>
        <Grid RowDefinitions="50,auto,auto"
              Padding="10"
              RowSpacing="10"
              ColumnSpacing="10">

            <HorizontalStackLayout Grid.Row="0" >
                <Entry x:Name="EntryDescription"
                   Placeholder="Enter description"
                   Text="{Binding Description}"
                   Margin="10,0"
                   WidthRequest="200"
                   />
                <Entry x:Name="EntryPrice"
                   Placeholder="Enter price"
                   Text="{Binding Price}"
                   Margin="10,0"
                   WidthRequest="200"
                   />
                <Button x:Name="BtnAdd"
                   Text="Add"
                   Command="{Binding AddSaleCommand}"
                   />

            </HorizontalStackLayout>

            <CollectionView Grid.Row="1" 
                            Margin="10"
                            SelectionMode="Single"
                            x:Name="CollViewSalesItems"
                            BackgroundColor="Cornsilk"
                            ItemsSource="{Binding Sales}"> <!--Remember to use Itemsource when dealing with ObservableCollections, it determines what to display-->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="mod:Sale">
                        <HorizontalStackLayout>
                            <Label Text="{Binding .}"> <!--This means it will bind to the whole object, instead of a single property, and show the objects ToString method-->
                                <!--DataTemplate refers to how you would like the imtems inside of your collection to be displayed in the ui. Basically define what one item looks like, and it will be repeated for all items-->
                                
                            </Label>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <Label
                x:Name="LblTotal"
                Grid.Row="2"
                Text=""
                Margin="10,0"/>
        </Grid>
    </ScrollView>
</ContentPage>
